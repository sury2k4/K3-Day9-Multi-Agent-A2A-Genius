# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# PostgreSQL used by Docker Compose
POSTGRES_DB=olist_disputes
POSTGRES_USER=olist
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://olist:change-me@postgres:5432/olist_disputes

# Langfuse Cloud
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Runtime paths inside the app container
DATA_DIR=data
INPUT_DIR=input
OUTPUT_DIR=output
LOGGING_DIR=logging
